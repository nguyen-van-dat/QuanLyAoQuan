<%- include('../layout/header', { title: title }) %>

<div class="min-h-screen bg-gradient-to-br from-slate-100 via-blue-50 to-indigo-100 py-10 px-4">

    <!-- Header -->
    <div class="max-w-7xl mx-auto bg-white/90 backdrop-blur shadow-xl rounded-3xl px-8 py-6 flex flex-col md:flex-row md:items-center md:justify-between border border-gray-100 mb-10">

        <div>
            <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight">
                 Tủ Đồ Của Tôi
            </h1>

            <p class="text-gray-500 mt-2 text-sm md:text-base">
                Quản lý outfit và quần áo yêu thích của bạn
            </p>
        </div>

        <div class="mt-4 md:mt-0 flex gap-3">

            <a href="/clothes/add"
               class="px-5 py-2.5 rounded-xl bg-green-500 text-white font-medium hover:bg-green-600 transition duration-300 shadow-md hover:shadow-lg">
                 Thêm đồ mới
            </a>
        </div>
    </div>

    <!-- Content -->
    <div class="max-w-7xl mx-auto">

        <% if (clothes.length > 0) { %>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">

                <% clothes.forEach((item, index) => { %>

                    <% if (item) { %>

                        <div class="group bg-white rounded-3xl shadow-lg overflow-hidden border border-gray-100 hover:shadow-2xl hover:-translate-y-1 transition duration-300">

                            <!-- Image -->
                            <div class="relative overflow-hidden">
                                <img
                                    src="<%= item.imageUrl %>"
                                    alt="<%= item.name %>"
                                    class="w-full h-72 object-cover group-hover:scale-105 transition duration-500"
                                >

                                <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded-full text-sm font-semibold text-indigo-600 shadow">
                                    <%= item.type %>
                                </div>
                            </div>

                            <!-- Content -->
                            <div class="p-5">

                                <h3 class="text-xl font-bold text-gray-800 mb-3 line-clamp-1">
                                    <%= item.name %>
                                </h3>

                                <div class="flex items-center justify-between mb-5">

                                    <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">
                                         <%= item.type %>
                                    </span>

                                    <span class="px-3 py-1 bg-pink-100 text-pink-700 rounded-full text-sm font-medium">
                                         <%= item.season %>
                                    </span>
                                </div>

                                <!-- Actions -->
                                <div class="flex gap-3">

                                    <a
                                        href="/clothes/delete/<%= index %>"
                                        onclick="return confirm('Bạn có chắc muốn xóa món đồ này?');"
                                        class="flex-1 text-center bg-red-500 text-white py-2.5 rounded-xl font-semibold hover:bg-red-600 transition duration-300"
                                    >
                                        🗑 Xóa
                                    </a>
                                </div>
                            </div>
                        </div>

                    <% } %>

                <% }) %>

            </div>

        <% } else { %>

            <!-- Empty State -->
            <div class="max-w-xl mx-auto bg-white rounded-3xl shadow-xl p-10 text-center border border-gray-100">

                <div class="text-7xl mb-6">
                    👕
                </div>

                <h2 class="text-3xl font-bold text-gray-700 mb-4">
                    Tủ đồ đang trống
                </h2>

                <p class="text-gray-500 mb-8 text-lg">
                    Hãy thêm món đồ đầu tiên để bắt đầu quản lý outfit của bạn.
                </p>

                <a
                    href="/clothes/add"
                    class="inline-block px-8 py-3 bg-gradient-to-r from-indigo-500 to-blue-500 text-white rounded-2xl font-semibold text-lg hover:scale-105 transition duration-300 shadow-lg"
                >
                     Thêm quần áo ngay
                </a>
            </div>

        <% } %>
    </div>
</div>

